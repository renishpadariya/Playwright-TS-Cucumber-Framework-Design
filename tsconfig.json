{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],

    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,

    "outDir": "dist",
    "rootDir": ".",

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* ✅ IMPORTANT FOR CUCUMBER WORLD EXTENSION */
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ]
  },

  "include": [
    "types/**/*.d.ts",        // ✅ include cucumber.d.ts
    "config/**/*.ts",
    "features/**/*.ts",
    "step_definitions/**/*.ts",
    "world/**/*.ts",
    "pages/**/*.ts",
    "utils/**/*.ts",
    "fixtures/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "reports"
  ]
}
